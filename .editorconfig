# https://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,yml,yaml,json,js,css,html,rs,toml}]
indent_style = space
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf
