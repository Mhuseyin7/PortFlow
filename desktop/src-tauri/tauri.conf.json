{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PortFlow",
  "version": "0.1.0",
  "identifier": "dev.portflow.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:9280",
    "frontendDist": "http://127.0.0.1:9280"
  },
  "app": {
    "windows": [
      {
        "title": "PortFlow",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Local HTTPS domains for development",
    "longDescription": "PortFlow turns messy local development ports into stable local HTTPS domains and provides a central registry for development services."
  }
}
