# Normalize line endings so Windows checkouts don't rewrite history with CRLF.
# Source files are always LF in the repo; working copies may use native EOL.

* text=auto eol=lf

*.go       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.rs       text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.sh       text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
*.plist    text eol=lf
Makefile   text eol=lf
LICENSE    text eol=lf

# Keep Windows batch scripts in CRLF
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary extensions
*.png      binary
*.jpg      binary
*.ico      binary
*.db       binary
*.pem      binary
*.key      binary
